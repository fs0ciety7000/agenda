// Modèle de données — voir docs/database.md pour les justifications.
// Conventions : UUID, householdId sur toute donnée métier, soft delete via deletedAt,
// `version` pour la concurrence optimiste.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ───────────────────────────── Identité ─────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.Citext
  passwordHash String?
  displayName  String    @db.VarChar(60)
  locale       String    @default("fr") @db.VarChar(5)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  /// Compte désactivé par un administrateur : plus aucune connexion possible.
  disabledAt   DateTime?

  sessions             Session[]
  identities           AuthIdentity[]
  memberships          HouseholdMember[]
  googleConnections    GoogleConnection[]
  resetTokens          PasswordResetToken[]
  mobileAuthCodes      MobileAuthCode[]
  pushTokens           PushToken[]
  webPushSubscriptions WebPushSubscription[]
  reports              Report[]
  passkeys             Passkey[]
}

/// Passkey (WebAuthn) : clé publique d'un appareil ou d'un gestionnaire de mots de passe.
model Passkey {
  /// Identifiant de la clé (base64url), choisi par l'authentificateur.
  id         String    @id @db.VarChar(512)
  userId     String    @db.Uuid
  publicKey  Bytes
  counter    Int       @default(0)
  transports String[]
  backedUp   Boolean   @default(false)
  name       String    @db.VarChar(60)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Défi WebAuthn à usage unique (5 minutes), pour l'enregistrement ou la connexion.
model WebAuthnChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  challenge String   @db.VarChar(128)
  /// Enregistrement : l'utilisateur connecté ; connexion : null (clé découvrable).
  userId    String?  @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum AuthProvider {
  GOOGLE
}

/// Login fédéré (Google OIDC). Jamais lié par email : uniquement par `sub`.
model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String       @db.VarChar(255)
  createdAt       DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

/// Une session = un appareil. Le refresh token n'est stocké que haché (SHA-256).
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  /// Tous les refresh tokens issus d'une même connexion partagent la famille.
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique @db.Char(64)
  userAgent        String?   @db.VarChar(255)
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  /// Renseigné lors d'une rotation : un token déjà remplacé et rejoué = vol probable.
  replacedAt       DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Code à usage unique remis à l'app Android après « Continuer avec Google » (2 min).
/// Échangé contre une session uniquement avec le `code_verifier` PKCE resté dans l'app.
model MobileAuthCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique @db.Char(64)
  challenge String    @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Foyer ─────────────────────────────

model Household {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(80)
  timezone  String    @default("Europe/Brussels") @db.VarChar(64)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members        HouseholdMember[]
  invitations    HouseholdInvitation[]
  categories     Category[]
  tasks          Task[]
  occurrences    TaskOccurrence[]
  checklistItems ChecklistItem[]
  shoppingItems  ShoppingItem[]
  templates      TaskTemplate[]
  attachments    TaskAttachment[]
  calendarLink   HouseholdCalendarLink?
  activity       ActivityLog[]
  absences       MemberAbsence[]
  comments       TaskComment[]
  products       ShoppingProduct[]
  meals          Meal[]
  expenses       Expense[]
}

enum HouseholdRole {
  OWNER
  MEMBER
}

/// Commentaire sur une tâche (commun à toutes ses occurrences). Visible par ceux qui voient la tâche.
model TaskComment {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  taskId      String   @db.Uuid
  /// null = ancien membre supprimé.
  authorId    String?  @db.Uuid
  body        String   @db.VarChar(2000)
  createdAt   DateTime @default(now())

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    HouseholdMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

/// Mode absence : du startDate au endDate inclus (dates locales du foyer), les tâches partagées
/// du membre passent aux autres (rotation comprise). Ses tâches personnelles ne bougent pas.
model MemberAbsence {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  memberId    String   @db.Uuid
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  createdAt   DateTime @default(now())

  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([householdId, endDate])
}

model HouseholdMember {
  id            String        @id @default(uuid()) @db.Uuid
  householdId   String        @db.Uuid
  /// null = compte supprimé (RGPD) : le membre reste, anonymisé, pour l'historique partagé.
  userId        String?       @db.Uuid
  role          HouseholdRole @default(MEMBER)
  displayName   String        @db.VarChar(40)
  /// Nom d'un token de couleur (sage, ocean…), jamais un hex libre.
  color         String        @db.VarChar(16)
  joinedAt      DateTime      @default(now())
  leftAt        DateTime?
  /// Adresse « créer une tâche par e-mail » (partie après le +). Secrète ; null = désactivée.
  inboundToken  String?       @unique @db.VarChar(40)
  /// Accusé de réception des tâches créées par e-mail.
  inboundAck    Boolean       @default(true)
  /// Abonnement iCal (lecture seule, Apple Calendrier, Outlook…). Secret ; null = désactivé.
  icalToken     String?       @unique @db.VarChar(40)
  /// Proportion de partage des dépenses communes (poids relatif ; 1 et 1 = moitié-moitié).
  expenseWeight Int           @default(1)

  household            Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user                 User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdTasks         Task[]                   @relation("TaskCreatedBy")
  rotationSlots        RotationSlot[]
  assignments          OccurrenceAssignee[]
  completedOccurrences TaskOccurrence[]         @relation("OccurrenceCompletedBy")
  notifications        Notification[]
  preferences          NotificationPreference[]
  sentInvitations      HouseholdInvitation[]
  activity             ActivityLog[]
  absences             MemberAbsence[]
  comments             TaskComment[]
  thanks               OccurrenceThanks[]
  expensesPaid         Expense[]                @relation("ExpensePaidBy")
  expensesFor          Expense[]                @relation("ExpenseFor")
  expenseShares        ExpenseShare[]

  @@unique([householdId, userId])
  @@index([userId])
}

model HouseholdInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  invitedById String    @db.Uuid
  email       String?   @db.Citext
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy HouseholdMember @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  householdId String    @db.Uuid
  /// Clé de traduction des catégories par défaut (null si créée par l'utilisateur).
  key         String?   @db.VarChar(32)
  name        String    @db.VarChar(40)
  emoji       String?   @db.VarChar(16)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tasks     Task[]

  // Unicité (householdId, name) parmi les non supprimées : index partiel en SQL (migration).
  @@index([householdId])
}

// ───────────────────────────── Tâches ─────────────────────────────

enum TaskVisibility {
  PERSONAL
  SHARED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id             String         @id @default(uuid()) @db.Uuid
  householdId    String         @db.Uuid
  createdById    String         @db.Uuid
  categoryId     String?        @db.Uuid
  title          String         @db.VarChar(200)
  notes          String?        @db.VarChar(5000)
  location       String?        @db.VarChar(200)
  priority       TaskPriority   @default(NORMAL)
  visibility     TaskVisibility @default(SHARED)
  /// « Ajouter au calendrier partagé ». Forcé à false pour les tâches PERSONAL (CHECK SQL).
  syncToCalendar Boolean        @default(false)
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy   HouseholdMember  @relation("TaskCreatedBy", fields: [createdById], references: [id])
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  series      TaskSeries[]
  occurrences TaskOccurrence[]
  attachments TaskAttachment[]
  comments    TaskComment[]

  @@index([householdId, deletedAt])
  @@index([categoryId])
}

enum RotationMode {
  UNASSIGNED
  FIXED
  TOGETHER
  ALTERNATE
  SEQUENCE
  WEEKDAY
}

enum RotationAdvance {
  PER_OCCURRENCE
  PER_WEEK
}

/// Règle de récurrence + rotation d'une tâche sur [startDate, untilDate].
/// « Cette occurrence et les suivantes » = on clôt la série et on en crée une nouvelle.
model TaskSeries {
  id              String          @id @default(uuid()) @db.Uuid
  taskId          String          @db.Uuid
  /// RecurrenceRule (packages/contracts), validé par Zod.
  rule            Json
  startDate       DateTime        @db.Date
  untilDate       DateTime?       @db.Date
  count           Int?
  startMinute     Int?
  durationMinutes Int?
  allDay          Boolean         @default(false)
  rotationMode    RotationMode    @default(UNASSIGNED)
  rotationAdvance RotationAdvance @default(PER_OCCURRENCE)
  /// Décalage d'index pour que la rotation continue après un split.
  rotationOffset  Int             @default(0)
  /// Dernière date matérialisée (horizon glissant de 90 jours).
  generatedUntil  DateTime?       @db.Date
  version         Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  slots       RotationSlot[]
  occurrences TaskOccurrence[]

  @@index([taskId])
}

/// Qui fait quoi. Une « position » peut contenir plusieurs membres (= à deux).
/// weekday null = s'applique à tous les jours ; sinon rotation propre à ce jour (0 = lundi).
model RotationSlot {
  id       String @id @default(uuid()) @db.Uuid
  seriesId String @db.Uuid
  weekday  Int?   @db.SmallInt
  position Int    @db.SmallInt
  memberId String @db.Uuid

  series TaskSeries      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  member HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([seriesId, weekday, position, memberId])
  @@index([memberId])
}

enum OccurrenceStatus {
  TODO
  DONE
  SKIPPED
  CANCELLED
}

model TaskOccurrence {
  id              String           @id @default(uuid()) @db.Uuid
  /// Dénormalisé pour l'isolation et les index (toujours = task.householdId).
  householdId     String           @db.Uuid
  taskId          String           @db.Uuid
  seriesId        String?          @db.Uuid
  /// Index de l'occurrence dans sa série (entrée de la rotation).
  seriesIndex     Int?
  /// Date prévue par la règle (≈ RECURRENCE-ID). Identité stable de l'occurrence.
  originalDate    DateTime?        @db.Date
  /// Date effective (peut différer si déplacée). null = non planifiée.
  date            DateTime?        @db.Date
  /// Échéance souple d'une tâche non planifiée (« cette semaine » = dimanche). Ignorée si `date`.
  dueDate         DateTime?        @db.Date
  startMinute     Int?
  durationMinutes Int?
  allDay          Boolean          @default(false)
  /// Dérivés (fuseau du foyer) pour les requêtes par plage.
  startsAt        DateTime?
  endsAt          DateTime?
  status          OccurrenceStatus @default(TODO)
  /// Modifiée individuellement : jamais réécrite par la régénération de la série.
  isException     Boolean          @default(false)
  titleOverride   String?          @db.VarChar(200)
  notesOverride   String?          @db.VarChar(5000)
  completedAt     DateTime?
  completedById   String?          @db.Uuid
  version         Int              @default(1)
  /// Incrémenté à chaque changement visible dans Google Calendar.
  syncVersion     Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  household   Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  task        Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  series      TaskSeries?          @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  completedBy HouseholdMember?     @relation("OccurrenceCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  assignees   OccurrenceAssignee[]
  eventLink   CalendarEventLink?
  checklist   ChecklistItem[]
  thanks      OccurrenceThanks[]

  @@unique([seriesId, originalDate])
  @@index([householdId, date])
  @@index([householdId, status, startsAt])
  @@index([taskId])
}

/// Fichier joint à une tâche (photo, facture PDF…), stocké en base : inclus dans les sauvegardes.
/// Limites : 10 Mo par fichier, 200 Mo par foyer.
model TaskAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  taskId      String   @db.Uuid
  filename    String   @db.VarChar(255)
  contentType String   @db.VarChar(127)
  size        Int
  data        Bytes
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([householdId])
}

/// Sous-tâches / liste (ex. courses) d'une occurrence : cochées à deux, ordre libre.
model ChecklistItem {
  id           String   @id @default(uuid()) @db.Uuid
  /// Dénormalisé pour l'isolation (toujours = occurrence.householdId).
  householdId  String   @db.Uuid
  occurrenceId String   @db.Uuid
  text         String   @db.VarChar(200)
  done         Boolean  @default(false)
  /// Membre qui a coché (pas de clé étrangère : un ancien membre reste lisible comme « quelqu'un »).
  doneById     String?  @db.Uuid
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household  Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  occurrence TaskOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([occurrenceId, position])
}

/// Modèle de tâches (« Ménage du samedi ») : plusieurs tâches créées d'un coup.
model TaskTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  name        String   @db.VarChar(80)
  emoji       String?  @db.VarChar(8)
  /// TemplateItem[] (packages/contracts), validé à l'écriture.
  items       Json
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

/// Liste de courses permanente du foyer. `id` peut être choisi par le client (ajout idempotent).
model ShoppingItem {
  id          String    @id @db.Uuid
  householdId String    @db.Uuid
  text        String    @db.VarChar(200)
  /// « 2 kg », « x6 »… (null = pas de quantité).
  quantity    String?   @db.VarChar(40)
  /// Rayon (Aisle de @agenda/domain) ; null = deviné à la lecture (articles d'avant).
  aisle       String?   @db.VarChar(16)
  done        Boolean   @default(false)
  /// Membres (jamais supprimés physiquement : anonymisés), sans clé étrangère.
  createdById String?   @db.Uuid
  doneById    String?   @db.Uuid
  doneAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, done])
}

enum MealSlot {
  LUNCH
  DINNER
}

/// Menus de la semaine : un repas (midi ou soir) avec ses ingrédients, envoyables aux courses.
model Meal {
  id                String    @id @default(uuid()) @db.Uuid
  householdId       String    @db.Uuid
  date              DateTime  @db.Date
  slot              MealSlot
  title             String    @db.VarChar(120)
  ingredients       String[]
  createdById       String?   @db.Uuid
  addedToShoppingAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, date])
}

/// Mémoire des courses du foyer : rayon choisi et fréquence d'achat de chaque produit
/// (suggestions « souvent achetés », rayon retenu quand on le corrige).
model ShoppingProduct {
  id           String    @id @default(uuid()) @db.Uuid
  householdId  String    @db.Uuid
  /// productKey() : minuscules, sans accents, singulier.
  key          String    @db.VarChar(200)
  label        String    @db.VarChar(200)
  aisle        String    @db.VarChar(16)
  timesBought  Int       @default(0)
  lastBoughtAt DateTime?
  lastAddedAt  DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, key])
}

/// « Merci » d'un membre pour une tâche faite par un autre (un par membre et par occurrence).
model OccurrenceThanks {
  occurrenceId String   @db.Uuid
  memberId     String   @db.Uuid
  createdAt    DateTime @default(now())

  occurrence TaskOccurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  member     HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([occurrenceId, memberId])
  @@index([memberId])
}

model OccurrenceAssignee {
  occurrenceId String @db.Uuid
  memberId     String @db.Uuid

  occurrence TaskOccurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  member     HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([occurrenceId, memberId])
  @@index([memberId])
}

// ───────────────────────────── Google Calendar ─────────────────────────────

enum GoogleConnectionStatus {
  ACTIVE
  REVOKED
  ERROR
}

/// Autorisation OAuth Calendar d'un utilisateur (distincte du login Google).
model GoogleConnection {
  id                   String                 @id @default(uuid()) @db.Uuid
  userId               String                 @db.Uuid
  googleSubject        String                 @db.VarChar(255)
  email                String                 @db.VarChar(254)
  /// AES-256-GCM, format v1:iv:tag:ciphertext (base64url).
  refreshTokenEnc      String
  accessTokenEnc       String?
  accessTokenExpiresAt DateTime?
  scopes               String[]
  status               GoogleConnectionStatus @default(ACTIVE)
  lastErrorCode        String?                @db.VarChar(64)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarLinks HouseholdCalendarLink[]

  @@unique([userId, googleSubject])
}

enum CalendarLinkStatus {
  ACTIVE
  /// Calendrier supprimé, plus partagé, ou droits insuffisants.
  INVALID
}

/// Le calendrier partagé du foyer (ex. « Commun G & N »). Jamais codé en dur.
model HouseholdCalendarLink {
  id               String             @id @default(uuid()) @db.Uuid
  householdId      String             @unique @db.Uuid
  connectionId     String             @db.Uuid
  googleCalendarId String             @db.VarChar(255)
  /// Cache d'affichage du nom ; l'identité est googleCalendarId.
  summary          String             @db.VarChar(255)
  accessRole       String             @db.VarChar(32)
  timeZone         String?            @db.VarChar(64)
  status           CalendarLinkStatus @default(ACTIVE)
  lastErrorCode    String?            @db.VarChar(64)
  lastReconciledAt DateTime?
  /// Dernière relève des modifications faites dans Google (sens Google → app).
  lastPulledAt     DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  household  Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  connection GoogleConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  events     CalendarEventLink[]
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  ERROR
  BLOCKED
  PENDING_DELETE
  DELETED
}

/// Mapping occurrence ↔ événement Google. Jamais par le titre.
model CalendarEventLink {
  id               String     @id @default(uuid()) @db.Uuid
  occurrenceId     String?    @unique @db.Uuid
  calendarLinkId   String     @db.Uuid
  googleCalendarId String     @db.VarChar(255)
  /// Déterministe : "gn" + uuid de l'occurrence sans tirets (cf. docs/google-calendar.md §4).
  googleEventId    String     @db.VarChar(1024)
  etag             String?    @db.VarChar(255)
  syncStatus       SyncStatus @default(PENDING)
  syncedVersion    Int        @default(0)
  attempts         Int        @default(0)
  nextAttemptAt    DateTime?
  lastErrorCode    String?    @db.VarChar(64)
  lastSyncedAt     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  occurrence   TaskOccurrence?       @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  calendarLink HouseholdCalendarLink @relation(fields: [calendarLinkId], references: [id], onDelete: Cascade)

  @@unique([googleCalendarId, googleEventId])
  @@index([syncStatus, nextAttemptAt])
}

// ───────────────────────────── Transverse ─────────────────────────────

enum NotificationType {
  TASK_UPCOMING
  TASK_OVERDUE
  TASK_REMINDER
  TASK_ASSIGNED
  ASSIGNEE_CHANGED
  CALENDAR_SYNC_FAILED
  TASK_COMMENT
  TASK_THANKS
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  memberId  String           @db.Uuid
  type      NotificationType
  /// Données minimales (ids), jamais de texte libre sensible.
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  member HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, readAt])
}

model NotificationPreference {
  id          String           @id @default(uuid()) @db.Uuid
  memberId    String           @db.Uuid
  type        NotificationType
  inApp       Boolean          @default(true)
  push        Boolean          @default(true)
  email       Boolean          @default(false)
  /// Délai de rappel avant l'échéance (TASK_UPCOMING).
  leadMinutes Int?

  member HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, type])
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  actorId     String?  @db.Uuid
  action      String   @db.VarChar(64)
  entityType  String   @db.VarChar(32)
  entityId    String   @db.Uuid
  /// Diff minimal (champs modifiés), sans données sensibles.
  data        Json?
  /// Titre au moment de l'action : le journal reste lisible après suppression ou renommage.
  title       String?  @db.VarChar(200)
  /// Tâche personnelle : entrée visible uniquement par son auteur.
  personal    Boolean  @default(false)
  createdAt   DateTime @default(now())

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actor     HouseholdMember? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt])
}

/// Rejeu sûr des requêtes (Android offline). Purgé après 24 h.
model IdempotencyKey {
  key          String   @id @db.VarChar(64)
  userId       String   @db.Uuid
  method       String   @db.VarChar(8)
  path         String   @db.VarChar(255)
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Jeton Firebase Cloud Messaging d'un téléphone (notifications instantanées, docs/android.md).
/// Le message envoyé ne contient aucune donnée : il réveille l'app, qui relit ses notifications.
/// Abonnement « Web Push » d'un navigateur (notifications du site, chiffrées de bout en bout).
model WebPushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  endpoint   String   @unique @db.VarChar(2048)
  p256dh     String   @db.VarChar(200)
  auth       String   @db.VarChar(100)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Sauvegardes : historique écrit par le conteneur `backup` (infra/backup/backup.sh), et demandes
/// manuelles faites depuis l'administration (status PENDING, prises en charge dans la minute).
model BackupRun {
  id          String    @id @default(uuid()) @db.Uuid
  /// manual | nightly | startup
  trigger     String    @db.VarChar(16)
  /// PENDING | RUNNING | OK | FAILED
  status      String    @db.VarChar(16)
  requestedBy String?   @db.Uuid
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  file        String?   @db.VarChar(255)
  sizeBytes   BigInt?
  /// « 2 comptes, 1 foyers, 12 occurrences » ou message d'erreur.
  summary     String?   @db.VarChar(500)
  offsite     Boolean   @default(false)

  @@index([createdAt])
}

// ───────────────────────────── Surveillance ─────────────────────────────

/// Résultat d'une sonde interne (toutes les minutes), gardé 7 jours.
model StatusCheck {
  id        String   @id @default(uuid()) @db.Uuid
  /// database | redis | calendar | email | backups
  component String   @db.VarChar(24)
  ok        Boolean
  latencyMs Int?
  detail    String?  @db.VarChar(200)
  checkedAt DateTime @default(now())

  @@index([component, checkedAt])
  @@index([checkedAt])
}

/// Disponibilité par composant et par jour (UTC), gardée 400 jours : page /status.
model StatusDaily {
  component  String   @db.VarChar(24)
  day        DateTime @db.Date
  checks     Int      @default(0)
  failures   Int      @default(0)
  latencySum Int      @default(0)

  @@id([component, day])
}

/// Incident : un composant en échec (ouvert après 2 sondes ratées, fermé au retour).
model Incident {
  id         String    @id @default(uuid()) @db.Uuid
  component  String    @db.VarChar(24)
  detail     String?   @db.VarChar(200)
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([startedAt])
}

/// Requêtes HTTP agrégées par minute (volume, erreurs, temps de réponse), gardées 8 jours.
model RequestMetric {
  minute     DateTime @id
  requests   Int      @default(0)
  errors4xx  Int      @default(0)
  errors5xx  Int      @default(0)
  latencySum Int      @default(0)
  latencyMax Int      @default(0)
  /// Réponses de plus d'une seconde.
  slow       Int      @default(0)
}

model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique @db.VarChar(4096)
  platform   String   @default("android") @db.VarChar(16)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Signalements ─────────────────────────────

enum ReportKind {
  BUG
  IDEA
  QUESTION
  OTHER
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Signalement (bug, idée, question) envoyé depuis le site ou l'app, traité dans l'administration.
/// Effacé avec le compte ; résolu ou fermé, effacé après 180 jours.
model Report {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  kind           ReportKind
  status         ReportStatus @default(OPEN)
  title          String       @db.VarChar(120)
  description    String       @db.VarChar(5000)
  allowContact   Boolean      @default(false)
  /// Informations techniques, seulement si l'utilisateur a choisi de les joindre.
  diagnostics    Json?
  screenshot     Bytes?
  screenshotType String?      @db.VarChar(40)
  reply          String?      @db.VarChar(5000)
  repliedAt      DateTime?
  /// Passage à RESOLVED ou CLOSED (point de départ de la durée de conservation).
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Dépenses du foyer : qui a payé quoi, et la part de chacun (montants en centimes d'euro).
enum ExpenseKind {
  EXPENSE
  SETTLEMENT
}

enum ExpenseSplit {
  SHARED
  FOR_OTHER
  PERSONAL
}

enum ExpenseCategory {
  GROCERIES
  HOUSING
  UTILITIES
  TRANSPORT
  LEISURE
  HEALTH
  KIDS
  GIFTS
  OTHER
}

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  householdId String          @db.Uuid
  kind        ExpenseKind     @default(EXPENSE)
  paidById    String          @db.Uuid
  amountCents Int
  date        DateTime        @db.Date
  title       String          @db.VarChar(120)
  category    ExpenseCategory @default(OTHER)
  split       ExpenseSplit    @default(SHARED)
  /// FOR_OTHER : pour qui ; SETTLEMENT : qui est remboursé.
  forMemberId String?         @db.Uuid
  note        String?         @db.VarChar(500)
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paidBy    HouseholdMember  @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  forMember HouseholdMember? @relation("ExpenseFor", fields: [forMemberId], references: [id], onDelete: SetNull)
  shares    ExpenseShare[]

  @@index([householdId, date])
}

/// Part de chacun dans une dépense, figée à l'enregistrement (changer les proportions du foyer
/// ne réécrit pas le passé).
model ExpenseShare {
  expenseId   String @db.Uuid
  memberId    String @db.Uuid
  amountCents Int

  expense Expense         @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([expenseId, memberId])
  @@index([memberId])
}
