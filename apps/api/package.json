{
  "name": "@agenda/api",
  "version": "0.0.0",
  "files": [
    "dist",
    "prisma",
    "docker-entrypoint.sh"
  ],
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "openapi": "node dist/openapi/generate.js"
  },
  "dependencies": {
    "@agenda/contracts": "workspace:*",
    "@agenda/domain": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.3",
    "@sentry/node": "^11.8.0",
    "@simplewebauthn/server": "^14.0.3",
    "argon2": "0.44.0",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "fflate": "0.8.3",
    "helmet": "8.1.0",
    "jose": "6.1.0",
    "multer": "2.4.0",
    "nestjs-pino": "4.4.1",
    "nodemailer": "10.1.0",
    "pino": "9.13.1",
    "pino-http": "10.5.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@agenda/config": "workspace:*",
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.13.5",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.8",
    "@types/supertest": "6.0.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.37.0",
    "pino-pretty": "13.1.1",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.4"
  }
}
