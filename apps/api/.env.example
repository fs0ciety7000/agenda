# ── API ──
NODE_ENV=development
PORT=4000
# URL publique de l'app web (CORS, redirections OAuth)
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://agenda:agenda@localhost:5432/agenda?schema=public
# Base jetable pour les tests d'intégration (recréée à chaque run)
TEST_DATABASE_URL=postgresql://agenda:agenda@localhost:5432/agenda_test?schema=public
REDIS_URL=redis://localhost:6379

# Secret de signature des access tokens (≥ 32 octets aléatoires) : openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
# Clé AES-256-GCM des tokens OAuth Google (32 octets en base64) : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Cookies : true en production (HTTPS)
COOKIE_SECURE=false

# ── Google (Phases 2 & 4) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/v1/calendar/google/callback

# Emails : sans SMTP_HOST, le lien de réinitialisation est affiché dans les logs (développement).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Agenda G & N <no-reply@example.invalid>

SENTRY_DSN=
AUTH_RATE_LIMIT=10
GLOBAL_RATE_LIMIT=600
REGISTRATION_ENABLED=true
# En production derrière Cloudflare : cf-connecting-ip
CLIENT_IP_HEADER=
