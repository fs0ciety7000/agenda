<?xml version="1.0" encoding="utf-8"?>
<!-- Jetons de session exclus des sauvegardes cloud et des transferts d'appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
