<?xml version="1.0" encoding="utf-8"?>
<!--
  Bord à bord sans les API obsolètes d'Android 15 (setStatusBarColor, setNavigationBarColor,
  layoutInDisplayCutoutMode) qu'appelait enableEdgeToEdge() : les barres système sont déclarées
  ici et le contenu passe dessous (MainActivity). Android 15+ impose le bord à bord et ignore
  ces couleurs.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Tandem" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/system_nav_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>
</resources>
