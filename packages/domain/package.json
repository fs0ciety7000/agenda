{
  "name": "@agenda/domain",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "private": true,
  "description": "Logique métier pure (dates/fuseaux, quick add ; récurrence et rotation en Phase 3). Aucune I/O.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
